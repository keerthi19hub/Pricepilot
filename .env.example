# ========================================================
# PricePilot Environment Configuration
# ========================================================

# Application Metadata
PROJECT_NAME="PricePilot"
PROJECT_TAGLINE="Shop Smart. Choose Better."
VERSION="1.0.0"

# Database Configuration
# Default: SQLite for immediate, zero-friction local development
DATABASE_URL="sqlite:///./pricepilot.db"
# Production / PostgreSQL option:
# DATABASE_URL="postgresql://postgres:postgres@localhost:5432/pricepilot"

# Security & Authentication
# Replace with a cryptographically secure random string in production
SECRET_KEY="replace_with_a_secure_random_key_in_production_environment"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# Transparency & Data Modes
DEMO_MODE=true
LIVE_SCRAPING_ENABLED=false
DATA_FRESHNESS_HOURS=24

# External Retailer Feeds (Placeholders - Add verified partner credentials here)
AMAZON_PAAPI_KEY=""
AMAZON_PAAPI_SECRET=""
FLIPKART_AFFILIATE_TOKEN=""
